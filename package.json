{
  "name": "vc-cost-app",
  "version": "0.6.17",
  "description": "Hệ thống quản lý – tính toán – đối chiếu chi phí vận chuyển (offline)",
  "main": "electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate-sample.js",
    "test:ui": "node tests/ui-smoke.mjs",
    "dev": "node tools/dev-server.js",
    "dist:win": "electron-builder --win --x64",
    "dist:setup": "electron-builder --win dir --x64 && python3 installer/make-setup.py $npm_package_version"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-sqlite3": "^13.1.1",
    "chart.js": "^4.5.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "tabulator-tables": "^6.6.1",
    "xlsx": "^0.18.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "vn.hak.vccost",
    "productName": "VC Cost",
    "copyright": "HAK Group",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "renderer/**",
      "data/seed/**",
      "package.json",
      "node_modules/**/*",
      "!node_modules/**/{test,tests,docs,*.md,*.map}",
      "!node_modules/electron/**",
      "!node_modules/playwright-core/**",
      "!node_modules/electron-builder/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/prebuilds/linux-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/linux-x64.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-x64.node",
      "!node_modules/better-sqlite3/prebuilds/linuxmusl-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/darwin-arm64.node",
      "!node_modules/better-sqlite3/prebuilds/darwin-x64.node",
      "!node_modules/better-sqlite3/prebuilds/win32-arm64.node"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "forceCodeSigning": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "VC-Cost-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "VC-Cost-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "VC-Cost-${version}-Setup.${ext}",
      "language": "1066"
    }
  }
}
